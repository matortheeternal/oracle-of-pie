{
  "name": "oracle-of-pie",
  "version": "0.1.0",
  "private": true,
  "description": "Reads Magic: The Gathering Oracle text into a semantic tree, suggests Scryfall oracle tags, and inspects cards for color pie breaks.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*"
  },
  "dependencies": {
    "mana-scribe": "^2.4.2"
  },
  "devDependencies": {
    "@sigil-sifter/magic": "^1.2.0",
    "@sigil-sifter/magic-scryfall": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "sigil-sifter": "^1.0.0",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "lint": "eslint src tasks lint eslint.config.js --max-warnings 0",
    "corpus": "node tasks/buildCorpus.js",
    "tag": "node tasks/tagCorpus.js",
    "score": "node tasks/scoreTags.js",
    "evaluate": "npm run tag && npm run score",
    "compare-corpus": "node tasks/compareCorpus.js",
    "diagnose": "node tasks/diagnose.js",
    "gaps": "node tasks/gapReport.js",
    "queues": "node tasks/buildCustomQueue.js && node tasks/buildScryfallQueues.js && node tasks/buildPieQueues.js",
    "review": "node tasks/review.js",
    "gap-workbench": "node --watch tasks/review.js",
    "report": "node tasks/reviewReport.js",
    "verdicts": "node tasks/checkVerdicts.js",
    "policies": "node tasks/checkPolicies.js",
    "pie": "node tasks/buildPieProfiles.js && node tasks/inspectPie.js",
    "pie-gate": "node tasks/pieGate.js",
    "pie-verdicts": "node tasks/checkPieVerdicts.js",
    "ast-fixtures": "node tasks/checkAstFixtures.js",
    "ast": "node tasks/inspectAst.js",
    "keyword-canon": "node tasks/buildKeywordCanon.js default-cards-*.jsonl.gz"
  }
}
